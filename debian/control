# Pulled in through the OpenCASCADE visualization link interface; the
# link fails without it on a system where nothing else supplies it.
 libfontconfig-dev,
 libzip-dev,
 libgit2-dev,
 libslvs-dev,
# Provides Qt 6's lrelease, which compiles resources/translations/*.ts into the .qm
# catalogs embedded in the binary. The CMake side looks it up with
# find_program rather than requiring LinguistTools, so that a third party
# without Qt Linguist can still build HobbyCAD, but the result is an
# English-only binary with no error at any stage. Declaring it here is what
# guarantees the *packaged* build actually ships the translations.
# Note this is NOT qt6-tools-dev-tools: on Debian and Ubuntu the Qt 6
# lrelease/lupdate binaries live in qt6-l10n-tools, and /usr/bin/lrelease is
# a qtchooser symlink that resolves to Qt 5.
 qt6-l10n-tools,
 nlohmann-json3-dev (>= 3.12.0),
# Optional at configure time, but their absence silently disables
# background-image loading and WebP support in the built package.
 libstb-dev,
 libwebp-dev
# Debian Policy 9.6 forbids shipping a .desktop file and a Debian menu file in
# the same package from Standards-Version 3.9.6 onwards. This package ships
# both: usr/share/applications/hobbycad.desktop for XDG desktops, and
# usr/share/menu/hobbycad because fluxbox reads only the classic Debian menu
# pipeline. Pinned below 3.9.6 so the declaration is truthful, the same
# workaround ClaudeQt used. Drop the pin and the menu file together once
# fluxbox consumes desktop entries.
Standards-Version: 3.9.5
