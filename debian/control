# 6.4.2, not 6.2: HOBBYCAD_MIN_QT_VERSION in the root CMakeLists is 6.4.2,
# and a >= 6.2 constraint is satisfied by jammy's stock 6.2.4, which then
# fails at configure. That mismatch is why the Qt 6.4.2 backport exists in
# the PPA; the dependency has to say so.
 qt6-base-dev (>= 6.4.2),
 qt6-base-dev-tools,
 libqt6opengl6-dev,
 libqt6openglwidgets6,
 libqt6svg6-dev,
 libocct-data-exchange-dev,
