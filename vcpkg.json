{
  "$comment": "HobbyCAD vcpkg manifest, located at <project-root>/vcpkg.json",
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "hobbycad",
  "version": "0.0.1",
  "description": "A Linux-native, open-source, parametric 3D CAD application",
  "homepage": "https://github.com/ayourk/hobbycad",
  "license": "GPL-3.0-only",
  "dependencies": [
    "opencascade",
    {
      "name": "freetype",
      "default-features": false,
      "features": ["bzip2", "zlib"]
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": ["thread", "concurrent", "xml", "gui", "opengl", "widgets",
                   "freetype", "harfbuzz", "jpeg", "png", "qtsvg"]
    },
    "qtsvg",
    {
      "$comment": "lrelease for the translation catalogs (the registry's qttools always builds the command-line tools; its linguist feature is the GUI). A target dependency on purpose: as a host dependency it would build a second qtbase for the host triplet, and every CI host is the target architecture.",
      "name": "qttools",
      "default-features": false
    },
    "opengl",
    "libzip",
    "libpng",
    "libjpeg-turbo",
    "libgit2",
    "libslvs",
    "lib3mf",
    "openmesh",
    "meshfix",
    "nlohmann-json",
    "libwebp"
  ],
  "$overrides-note": "Pinned versions (see docs/dev_environment_setup.txt §6.4)",
  "overrides": [
    { "name": "opencascade", "version": "8.0.1", "port-version": 0 },
    { "name": "libslvs",     "version-string": "3.2p1", "port-version": 1 },
    { "name": "qtbase",      "version": "6.4.2", "port-version": 25 },
    { "name": "qtsvg",       "version": "6.4.2", "port-version": 1 },
    { "name": "libzip",      "version": "1.7.3" },
    { "name": "libgit2",     "version": "1.9.2", "port-version": 1 }
  ]
}
